# Le Voisin — jamais dans Git.
#
# Ce dépôt est le miroir du code de le-voisin.com, servi depuis
# /sites/test.le-voisin.com/ chez Infomaniak. Il n'existe qu'UN site : « test »
# et « production » sont le même dossier. Un déploiement touche le public à
# l'instant même, et il n'y a pas d'environnement de repli.

# ---------------------------------------------------------------------------
# Secrets. Rien de ce bloc ne doit entrer dans l'historique : un commit grave,
# et un commit suivant n'efface pas.
# ---------------------------------------------------------------------------

# Identifiants de base de données, base_url, et le « secret » dont dérive le
# chiffrement des fiches personnelles. L'étoile couvre config.php.local et
# config.php.bak : un fichier oublié sous ce nom porte les mêmes secrets.
# config.sample.php n'est pas touché par ce motif et reste versionné.
config.php*

# L'installateur porte sa clé en clair (constante CLE). Cette clé donne
# l'exécution de code à distance sur le serveur public. Il vit sur le serveur,
# déposé par Web FTP quand on en a besoin — mieux encore, retiré entre deux
# déploiements.
/installateur.php

# Empreintes des mots de passe de la protection de dossier Infomaniak.
.htdigest*

# ---------------------------------------------------------------------------
# Données des personnes
# ---------------------------------------------------------------------------

# Contrats, fiches de salaire, factures, pièces d'identité. Ne vivent que sur
# le serveur (uploads/private/) et en sauvegarde — jamais dans un dépôt de code.
/uploads/

# ---------------------------------------------------------------------------
# Médias lourds du Catalogue
# ---------------------------------------------------------------------------

# Teasers, captations, photos HD, dossiers. Déposés par FTP et par lui seul :
# c'est la raison d'être du compte FTP. Aucun paquet de l'installateur ne les
# porte, et le dépôt ne doit jamais les voir.
#
# Cette ligne est écrite AVANT que le dossier n'existe, et c'est voulu. Le
# 07.08.2026, `dados/*.pdf` ne couvrait pas les sous-dossiers et 2,3 Mo de PDF
# sont restés à un `/syncar` d'arriver sur GitHub, `/syncar` faisant `git add -A`.
# Le mécanisme serait le même ici et d'un autre ordre de grandeur : une captation
# pèse plusieurs giga-octets et GitHub refuse au-delà de 100 Mo par fichier. Un
# historique ne se répare pas après coup, un commit suivant n'efface pas.
#
# Le dossier est créé par Catalog::dossier() à la première lecture d'une fiche,
# avec son .htaccess de refus. Les fichiers ne sont servis que par
# telechargement.php, derrière le mot de passe du Catalogue.
/medias/

# ---------------------------------------------------------------------------
# Artefacts, sauvegardes, journaux
# ---------------------------------------------------------------------------

# Sauvegardes automatiques de l'installateur.
/_sauvegardes/

# Copies manuelles faites avant une modification risquée (.htaccess, etc.).
*.bak

# Paquets de déploiement. TOUS, pas seulement les « maj-* » : le paquet
# le-voisin-code-2026-08-06.zip contenait une copie intégrale du site, dont
# installateur.php et sa clé. Ces archives se téléchargeaient depuis le web
# jusqu'au 11.08.2026 — elles n'ont leur place ni sur le serveur ni ici.
*.zip

# Journaux applicatifs.
/app/logs/
*.log

# Copie du site à l'intérieur de sa propre racine, trouvée le 11.08.2026.
# 23 Mo de code dupliqué, à retirer du serveur.
/le-voisin-site/

# Fichiers d'environnement macOS / éditeurs.
.DS_Store
.vscode/
